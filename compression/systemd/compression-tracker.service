[Unit]
Description=Compression Stats Tracker (Headroom + RTK)
After=network.target headroom-proxy.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/code/input-compression/scripts/compression-tracker.py --interval 2
Restart=on-failure
RestartSec=10
Environment="PATH=%h/.local/bin:/usr/local/cuda/bin:%H"
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=default.target
