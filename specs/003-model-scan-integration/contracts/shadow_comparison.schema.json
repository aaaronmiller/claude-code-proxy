{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.clutch/contracts/shadow_comparison.schema.json",
  "title": "Clutch model-scan shadow comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_id",
    "observed_at",
    "assignment_id",
    "source_scan_id",
    "source_schema_version",
    "execution_route",
    "execution_changed",
    "active_route",
    "shadow_route",
    "differences",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "comparison_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observed_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1
    },
    "source_scan_id": {
      "type": "integer",
      "minimum": 0
    },
    "source_schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "execution_route": {
      "const": "active"
    },
    "execution_changed": {
      "const": false
    },
    "active_route": {
      "$ref": "#/$defs/route"
    },
    "shadow_route": {
      "$ref": "#/$defs/route"
    },
    "differences": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/difference"
      }
    },
    "evidence_refs": {
      "$ref": "#/$defs/nonempty_unique_strings"
    }
  },
  "$defs": {
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "nonempty_unique_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "provider_id",
        "base_url",
        "fallbacks"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "fallbacks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metric_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "numeric_value",
        "unit",
        "items",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "numeric_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_unique_strings"
        }
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "status",
        "active",
        "shadow"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "compatibility",
            "privacy",
            "quota",
            "cost",
            "latency",
            "capability",
            "fallbacks"
          ]
        },
        "status": {
          "enum": [
            "same",
            "different",
            "unknown"
          ]
        },
        "active": {
          "$ref": "#/$defs/metric_evidence"
        },
        "shadow": {
          "$ref": "#/$defs/metric_evidence"
        }
      }
    }
  }
}
