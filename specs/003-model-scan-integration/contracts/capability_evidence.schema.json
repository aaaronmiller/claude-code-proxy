{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.clutch/contracts/capability_evidence.schema.json",
  "title": "Model Scan capability evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability_record"
      }
    }
  },
  "$defs": {
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "nonempty_unique_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nullable_nonnegative_number": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "capability_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "model_identity",
        "dimensions",
        "features",
        "health",
        "cost",
        "latency_ms",
        "confidence",
        "evidence_refs",
        "measured_at"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "model_identity": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "health": {
          "enum": [
            "healthy",
            "degraded",
            "unreachable",
            "unknown"
          ]
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_per_million",
            "output_per_million",
            "blended_per_million"
          ],
          "properties": {
            "input_per_million": {
              "$ref": "#/$defs/nullable_nonnegative_number"
            },
            "output_per_million": {
              "$ref": "#/$defs/nullable_nonnegative_number"
            },
            "blended_per_million": {
              "$ref": "#/$defs/nullable_nonnegative_number"
            }
          }
        },
        "latency_ms": {
          "$ref": "#/$defs/nullable_nonnegative_number"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_unique_strings"
        },
        "measured_at": {
          "$ref": "#/$defs/utc_timestamp"
        }
      }
    }
  }
}
