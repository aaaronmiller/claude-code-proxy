{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.clutch/contracts/task_classification.schema.json",
  "title": "Clutch task classification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification_id",
    "classified_at",
    "classifier_version",
    "taxonomy_version",
    "input_ref",
    "task_class",
    "task_family",
    "required_capabilities",
    "privacy_class",
    "importance",
    "confidence",
    "decision_provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "classification_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "classified_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "classifier_version": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "input_ref": {
      "type": "string",
      "minLength": 1
    },
    "task_class": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "task_family": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "required_capabilities": {
      "$ref": "#/$defs/nonempty_unique_identifiers"
    },
    "privacy_class": {
      "enum": [
        "public",
        "proprietary"
      ]
    },
    "importance": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "decision_provenance": {
      "$ref": "#/$defs/nonempty_unique_strings"
    }
  },
  "$defs": {
    "nonempty_unique_identifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]*$"
      }
    },
    "nonempty_unique_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
