{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.clutch/contracts/callable_catalog.schema.json",
  "title": "Clutch callable catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/callable_record"
      }
    }
  },
  "$defs": {
    "callable_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callable_id",
        "provider_id",
        "api_model_id",
        "base_url",
        "credential_ref",
        "observed_at",
        "reachable",
        "features",
        "provenance"
      ],
      "properties": {
        "callable_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "api_model_id": {
          "type": "string",
          "minLength": 1
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "credential_ref": {
          "type": "string",
          "pattern": "^[A-Z_][A-Za-z0-9_.:-]*$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "reachable": {
          "type": "boolean"
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
